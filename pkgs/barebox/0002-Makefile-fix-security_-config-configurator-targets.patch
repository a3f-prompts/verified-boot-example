From 08cc4f8b6c4af8f1aede57a824c196847510fc45 Mon Sep 17 00:00:00 2001
From: Ahmad Fatoum <a.fatoum@pengutronix.de>
Date: Sat, 29 Aug 2026 10:21:24 +0200
Subject: [PATCH] Makefile: fix security_%config configurator targets

The security_%config targets documented in
Documentation/user/security-policies.rst are broken in two ways:

Any make goal ending in "config" is classified as a Kconfig target and
dispatched to scripts/kconfig, so "make security_olddefconfig" fails with

  make[2]: *** No rule to make target 'security_olddefconfig'.  Stop.

Exclude the security_% goals from the config-build classification, so
they reach their rules in the main Makefile.

Once they do, collect-policies has nothing to collect: it is derived
from $(barebox-alldirs), which is not defined anywhere, so the
configurator only ever sees policy-list files left behind by a previous
build and is otherwise a silent no-op. Start the collection at
$(build-dir) instead; scripts/Makefile.policy recurses into all
subdir-y from the top-level Kbuild.

Signed-off-by: Ahmad Fatoum <a.fatoum@pengutronix.de>
---
 Makefile | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/Makefile b/Makefile
index 9fbce93af285..5a6c76be90e2 100644
--- a/Makefile
+++ b/Makefile
@@ -272,7 +272,8 @@ endif
 need-compiler := $(may-sync-config)
 
 ifeq ($(KBUILD_EXTMOD),)
-    ifneq ($(filter %config,$(MAKECMDGOALS)),)
+    # security_%config targets configure security policies, not .config
+    ifneq ($(filter-out security_%,$(filter %config,$(MAKECMDGOALS))),)
         config-build := 1
         ifneq ($(words $(MAKECMDGOALS)),1)
             mixed-build := 1
@@ -1339,7 +1340,7 @@ targets += include/generated/sconfig_names.h
 
 KPOLICY = $(shell find $(objtree)/ -name policy-list -exec cat {} \;)
 
-collect-dirs    := $(addprefix _policy_collect_,$(barebox-alldirs))
+collect-dirs    := $(addprefix _policy_collect_,$(build-dir))
 
 PHONY += _policy_collect_clean $(collect-dirs) collect-policies
 _policy_collect_clean:
-- 
